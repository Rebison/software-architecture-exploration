<h1>
    <%= title %>
</h1>
<form class="note-form" action="<%= formAction %>" method="POST">
    <input type="text" name="title" placeholder="Title" value="<%= note.title || '' %>" required>
    <textarea name="description" placeholder="Description" required><%= note.description || '' %></textarea>
    <button type="submit">
        <%= buttonText %>
    </button>
</form>
<a href="/notes" class="back-link">← Back to Notes</a>